{
  "name": "vdsexamapp",
  "version": "2.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "testTimeout": 20000,
    "collectCoverageFrom": [
      "src/utils/learningEngine.js",
      "src/utils/learningStorage.js",
      "src/utils/trainingTransfer.js",
      "src/utils/trainingBackup.js",
      "src/components/LearningScreen.js",
      "src/components/LearningSummaryScreen.js",
      "src/components/InfoScreen.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ]
  },
  "private": true
}
